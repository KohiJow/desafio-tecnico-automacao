{
  "name": "desafio-tecnico-automacao-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E em Cypress do desafio tecnico de automacao",
  "scripts": {
    "test": "cypress run",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:ci": "cypress run --reporter junit --reporter-options mochaFile=cypress/results/junit-[hash].xml"
  },
  "devDependencies": {
    "cypress": "^15.9.0"
  }
}
